//LOSNIGHT JOB (LOS,0400),'LOS NIGHTLY',CLASS=A,MSGCLASS=X
//*--------------------------------------------------------------*
//* LOS NIGHTLY ORIGINATION CHAIN, SCHEDULED 23:30 ET             *
//* STEP010 PRICING  STEP020 UNDERWRITING  STEP030 CORE BANKING  *
//* STEP040 GL EXTRACT  STEP050 HMDA EXTRACT                      *
//*--------------------------------------------------------------*
//STEP010  EXEC PGM=LNPRC010
//APPSIN   DD DSN=LOS.PROD.APPS.DAILY,DISP=SHR
//RATESIN  DD DSN=LOS.PROD.RATESHT.DAILY,DISP=SHR
//PRICED   DD DSN=LOS.PROD.PRICED(+1),DISP=(NEW,CATLG),
//            DCB=(RECFM=FB,LRECL=200)
//STEP020  EXEC PGM=LNUWR020,COND=(4,LT)
//RUNDATE  DD DSN=LOS.PROD.RUNDATE,DISP=SHR
//PRICED   DD DSN=LOS.PROD.PRICED(+1),DISP=SHR
//DECISION DD DSN=LOS.PROD.DECISION(+1),DISP=(NEW,CATLG),
//            DCB=(RECFM=FB,LRECL=80)
//STEP030  EXEC PGM=LNFIS030,COND=(4,LT)
//RUNDATE  DD DSN=LOS.PROD.RUNDATE,DISP=SHR
//PRICED   DD DSN=LOS.PROD.PRICED(+1),DISP=SHR
//DECISION DD DSN=LOS.PROD.DECISION(+1),DISP=SHR
//FISOUT   DD DSN=LOS.PROD.FISACCT.MQ,DISP=(NEW,CATLG),
//            DCB=(RECFM=FB,LRECL=114)
//STEP040  EXEC PGM=LNGL040,COND=(4,LT)
//RUNDATE  DD DSN=LOS.PROD.RUNDATE,DISP=SHR
//DECISION DD DSN=LOS.PROD.DECISION(+1),DISP=SHR
//GLOUT    DD DSN=LOS.PROD.GL.EXTRACT,DISP=(NEW,CATLG),
//            DCB=(RECFM=FB,LRECL=85)
//STEP050  EXEC PGM=LNHMD050,COND=(4,LT)
//RATESIN  DD DSN=LOS.PROD.RATESHT.DAILY,DISP=SHR
//PRICED   DD DSN=LOS.PROD.PRICED(+1),DISP=SHR
//DECISION DD DSN=LOS.PROD.DECISION(+1),DISP=SHR
//HMDAOUT  DD DSN=LOS.PROD.HMDA.EXTRACT,DISP=(NEW,CATLG),
//            DCB=(RECFM=VB,LRECL=164)
